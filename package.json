{
  "name": "talentbridge-football",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma internacional de descubrimiento y evaluacion de talentos futbolisticos. FASE 1: arquitectura, autenticacion, permisos y migraciones iniciales.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:backend": "node --watch backend/src/index.js",
    "dev:frontend": "npx --yes serve public -l 5173",
    "start": "node backend/src/index.js",
    "migrate": "node scripts/migrate.js",
    "migrate:undo": "node scripts/migrate.js --undo",
    "seed": "node scripts/seed.js",
    "test": "node --test \"backend/tests/**/*.test.js\"",
    "test:watch": "node --watch --test \"backend/tests/**/*.test.js\"",
    "lint": "echo 'FASE 1: lint pendiente de configurar (biome/eslint)'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jose": "^5.9.0",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
